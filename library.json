{
  "$schema": "https://raw.githubusercontent.com/platformio/platformio-core/develop/platformio/assets/schema/library.json",
  "name": "ModbusRTUSlave",
  "version": "3.0.0",
  "description": "Portable Arduino Modbus RTU slave/server with cooperative TX, targeted broadcast and optional durable bridge ingress.",
  "keywords": [
    "arduino",
    "modbus",
    "modbus-rtu",
    "modbus-slave",
    "serial"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Cybergrany/ModbusRTUSlave.git"
  },
  "authors": [
    {
      "name": "C. M. Bulliner"
    },
    {
      "name": "Cybergrany contributors",
      "maintainer": true
    }
  ],
  "license": "MIT",
  "frameworks": "arduino",
  "platforms": "*",
  "headers": [
    "ModbusRTUSlave.h"
  ],
  "export": {
    "exclude": [
      ".git",
      ".github",
      ".pio"
    ]
  },
  "build": {
    "includeDir": "src",
    "srcDir": "src"
  }
}
